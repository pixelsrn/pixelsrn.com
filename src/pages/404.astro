---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — PixelsRN" description="That page doesn't exist.">
    <main id="main" class="flex w-full flex-col justify-center py-20">
        <p class="label">Error 404</p>
        <h1
            class="glow text-phosphor mt-3 font-mono text-2xl font-semibold tracking-tight"
        >
            No signal.
        </h1>
        <a
            href="/"
            class="hover:text-phosphor mt-6 inline-block self-start py-2 font-mono text-sm underline decoration-1 underline-offset-4 transition-colors"
        >
            Back to the homepage
        </a>
    </main>
</Base>