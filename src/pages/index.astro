---
import Base from "../layouts/Base.astro";
import Contact from "../components/Contact.astro";
import { SITE, TEAM, PUBLICATIONS } from "../config";
---

<Base>
    <main
        id="main"
        class="grid w-full gap-y-12 py-12 lg:grid-cols-2 lg:gap-x-16 lg:py-16"
    >
        <div class="lg:self-center">
            <h1
                class="glow text-phosphor max-w-md font-mono text-[1.625rem] leading-[1.3] font-semibold tracking-tight text-balance sm:text-[2rem] sm:leading-tight"
            >
                {SITE.tagline}
            </h1>
            <p class="mt-5 max-w-md text-lg text-pretty sm:mt-6">
                {SITE.subtext}
            </p>
            <p class="label mt-6">
                {SITE.legalName} &middot; {SITE.location} &middot; &copy; {
                    new Date().getFullYear()
                }
            </p>

            <div class="mt-10 hidden lg:block">
                <Contact />
            </div>
        </div>

        <div class="flex flex-col gap-y-10 lg:self-center">
            <section>
                <h2 class="label">Founders</h2>
                <ul class="mt-3">
                    {
                        TEAM.map((p) => (
                            <li class="border-rule border-b py-3 last:border-b-0">
                                <p class="text-text font-medium">{p.name}</p>
                                <p class="text-text-dim font-mono text-xs">
                                    {p.role}
                                </p>
                                {p.links.length > 0 && (
                                    <p class="-mb-1 flex flex-wrap items-center gap-x-4">
                                        {p.links.map((l) => (
                                            <a
                                                href={l.href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="hover:text-phosphor inline-block py-2 font-mono text-xs underline decoration-1 underline-offset-4 transition-colors sm:py-1.5"
                                            >
                                                {l.label}
                                                <span class="sr-only">
                                                    — {p.name}, opens in a new
                                                    tab
                                                </span>
                                            </a>
                                        ))}
                                    </p>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </section>

            {
                PUBLICATIONS.length > 0 && (
                    <section>
                        <h2 class="label">Selected work</h2>
                        <ul class="mt-3">
                            {PUBLICATIONS.map((w) => (
                                <li class="border-rule border-b py-3 last:border-b-0">
                                    <a
                                        href={w.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-text hover:text-phosphor font-medium text-pretty underline decoration-1 underline-offset-4 transition-colors"
                                    >
                                        {w.title}
                                        <span class="sr-only">
                                            , opens in a new tab
                                        </span>
                                    </a>
                                    <p class="text-text-dim font-mono text-xs">
                                        {w.venue}
                                    </p>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }
        </div>
    </main>
</Base>
