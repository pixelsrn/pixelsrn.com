---
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import Contact from "../components/Contact.astro";
import { SITE, NAV } from "../config";

interface Props {
    title?: string;
    description?: string;
}

const { title = SITE.name, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#080B09" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content={SITE.name} />
        <meta name="twitter:card" content="summary_large_image" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap"
        />

        {
            /* Cloudflare Web Analytics — paste your token and uncomment.
            Cookieless, so no consent banner is required. */
        }
        {
            /*
        <script
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon='{"token": "YOUR_TOKEN_HERE"}'></script>
        */
        }
    </head>

    <body class="flex min-h-dvh flex-col">
        <a
            href="#main"
            class="bg-void text-phosphor border-phosphor sr-only rounded-none border px-4 py-2 font-mono text-sm focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
        >
            Skip to content
        </a>

        <header
            class="border-rule bg-void/80 sticky top-0 z-40 border-b backdrop-blur-md"
        >
            <div
                class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8"
            >
                <a href="/" class="flex items-center gap-3">
                    <Mark class="size-5" />
                    <span
                        class="glow font-mono text-base font-semibold tracking-tight"
                    >
                        {SITE.name}
                    </span>
                </a>

                {
                    NAV.length > 0 && (
                        <nav class="flex items-center gap-5">
                            {NAV.map((item) => (
                                <a
                                    href={item.href}
                                    class="label hover:text-phosphor transition-colors"
                                    aria-current={
                                        Astro.url.pathname === item.href
                                            ? "page"
                                            : undefined
                                    }
                                >
                                    {item.label}
                                </a>
                            ))}
                        </nav>
                    )
                }
            </div>
        </header>

        <div class="mx-auto flex w-full max-w-5xl flex-1 px-5 sm:px-8">
            <slot />
        </div>

        <footer
            class="border-rule bg-void/80 sticky bottom-0 z-40 border-t backdrop-blur-md lg:hidden"
        >
            <div class="mx-auto max-w-5xl px-5 py-3 sm:px-8">
                <Contact variant="bar" />
            </div>
        </footer>
    </body>
</html>