---
import { SITE } from "../config";

interface Props {
    /** "bar" is the compact mobile toolbar version; "block" is inline on the page. */
    variant?: "block" | "bar";
}

const { variant = "block" } = Astro.props;
---

{variant === "bar" ? (
    <div>
        <p class="label">Contact</p>
        <a
            href={`mailto:${SITE.email}`}
            class="text-phosphor hover:decoration-phosphor/40 mt-0.5 inline-block font-mono text-base font-medium wrap-anywhere underline decoration-1 underline-offset-4 transition-colors"
        >
            {SITE.email}
        </a>
    </div>
) : (
    <section>
        <h2 class="label">Contact</h2>
        <a
            href={`mailto:${SITE.email}`}
            class="text-phosphor hover:decoration-phosphor/40 mt-2 inline-block font-mono text-lg font-medium wrap-anywhere underline decoration-2 underline-offset-6 transition-colors"
        >
            {SITE.email}
        </a>
        <p class="text-text-dim mt-2 max-w-sm text-base text-pretty">
            {SITE.disclaimer}
        </p>
    </section>
)}
